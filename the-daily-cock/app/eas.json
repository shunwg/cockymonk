{
  "cli": {
    "version": ">= 21.0.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "testflight": {
      "extends": "production",
      "channel": "preview"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "PLACEHOLDER-fill-in-after-creating-the-App-Store-Connect-record",
        "ascApiKeyPath": "../../secrets/AuthKey_PLACEHOLDER.p8",
        "ascApiKeyId": "PLACEHOLDER",
        "ascApiKeyIssuerId": "PLACEHOLDER"
      }
    }
  }
}
