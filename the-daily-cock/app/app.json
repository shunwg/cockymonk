{
  "expo": {
    "name": "Cockerel",
    "slug": "cockerel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#8F2230",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mats.cockerel",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mats.cockerel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive-foreground.png",
        "backgroundColor": "#8F2230"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "adb76640-bf4e-4d29-acd6-4feaf8bba9c7"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/adb76640-bf4e-4d29-acd6-4feaf8bba9c7",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
