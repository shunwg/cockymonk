{
  "expo": {
    "name": "Cockerel",
    "slug": "cockerel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#8F2230",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mats.cockerel",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mats.cockerel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-adaptive-foreground.png",
        "backgroundColor": "#8F2230"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "PLACEHOLDER-run-eas-init-to-fill-this-in"
      }
    },
    "updates": {
      "url": "PLACEHOLDER-filled-by-eas-init",
      "checkAutomatically": "ON_LOAD"
    },
    "plugins": [
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
