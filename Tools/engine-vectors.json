    {
      "id": "R7-drop-mid-round",
      "desc": "PRD §5.5: a bluffer drops mid-round → their pending bluff and vote are skipped; scoring proceeds with the rest.",
      "players": ["GM", "Anne", "Bo", "Cam"],
