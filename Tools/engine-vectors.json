  ],
  "games": [
    {
      "id": "G1-win-only-at-rotation-end",
      "desc": "PRD §5.4 + D2: crossing the target mid-rotation does not win; the check fires only when the rotation completes.",
      "players": ["Anne", "Bo", "Cam"],
      "target": 8,
