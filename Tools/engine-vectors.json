    {
      "id": "G3-omkamp-still-tied-shared-victory",
      "desc": "PRD §5.4: omkamp resolves nothing → shared victory, shared confetti.",
      "players": ["Anne", "Bo", "Cam"],
      "target": 8,
      "setup": { "scores": { "0": 9, "1": 9, "2": 3 }, "inOmkamp": true, "participants": [0, 1] },
      "omkampDeltas": { "0": 1, "1": 1, "2": 0 },
