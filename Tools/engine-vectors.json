      "desc": "PRD §5.3 rows 1-2: +2 truth voter, +1 per vote to lie authors (incl. GM decoy).",
      "players": ["GM", "Anne", "Bo", "Cam"],
      "options": [
        { "id": "t", "kind": "truth", "authors": [] },
        { "id": "a", "kind": "bluff", "authors": [1] },
        { "id": "b", "kind": "bluff", "authors": [2] },
        { "id": "c", "kind": "bluff", "authors": [3] },
        { "id": "d", "kind": "decoy", "authors": [0] }
      ],
      "votes": { "1": "t", "2": "a", "3": "d" },
      "expected": {
        "deltas": { "0": 1, "1": 3, "2": 0, "3": 0 },
        "gmStole": false,
        "bluffVotes": { "0": 1, "1": 1, "2": 0, "3": 0 }
      }
    },
    {
      "id": "R2-gm-steal",
      "desc": "PRD §5.3 row 3: nobody voted the truth → GM +2, on top of GM decoy votes.",
      "players": ["GM", "Anne", "Bo", "Cam"],
      "options": [
        { "id": "t", "kind": "truth", "authors": [] },
        { "id": "a", "kind": "bluff", "authors": [1] },
        { "id": "b", "kind": "bluff", "authors": [2] },
        { "id": "c", "kind": "bluff", "authors": [3] },
        { "id": "d", "kind": "decoy", "authors": [0] }
      ],
      "votes": { "1": "b", "2": "d", "3": "a" },
      "expected": {
        "deltas": { "0": 3, "1": 1, "2": 1, "3": 0 },
        "gmStole": true,
        "bluffVotes": { "0": 1, "1": 1, "2": 1, "3": 0 }
      }
    },
    {
      "id": "R3-dobbeltreff",
      "desc": "PRD §5.3 row 4 + D3: Bo's bluff ≈ truth → +3, merged out of the pool; Bo may still vote the truth.",
      "players": ["GM", "Anne", "Bo", "Cam"],
      "doubles": [2],
      "options": [
        { "id": "t", "kind": "truth", "authors": [] },
        { "id": "a", "kind": "bluff", "authors": [1] },
        { "id": "c", "kind": "bluff", "authors": [3] }
      ],
      "votes": { "1": "t", "2": "t", "3": "a" },
      "expected": {
        "deltas": { "0": 0, "1": 3, "2": 5, "3": 0 },
