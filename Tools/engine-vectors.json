{
  "$schema_note": "Language-neutral rules authority for Cocky Monk, generated from PRD §5.3 (scoring), §5.4 (length & fairness) and §5.5 (edge cases). Drives Lab/js/engine.test.mjs (node --test) now and Tests/EngineTests (Swift Testing) on Mac day. The Lab and the demo are NOT rules authorities — this file is. Player index 0 in each round vector is that round's GM. Options of kind 'truth' have no authors; 'decoy' options are authored by the GM; voters never see options they authored (E5) and the GM never votes (E6).",
  "decisions": [
    { "id": "D1", "note": "Merged identical bluffs (PRD §5.5): each author scores ceil(votes/authorCount); for the Gullnese bluffVotes tally each author is credited the option's full vote count." },
    { "id": "D2", "note": "Win threshold: score >= target, checked only when round % playerCount == 0 (demo line 807 behavior, canonical per PRD §5.4 'full rotation')." },
    { "id": "D3", "note": "Dobbeltreff authors are removed from the option pool (their bluff merges with truth), receive +3, and still vote; the truth option remains votable by them (truth has no authors)." }
  ],
  "rounds": [
