  ],
  "behaviors": [
    {
      "id": "E1-empty-bluff-rejected",
      "desc": "PRD §5.5: empty/whitespace bluff is blocked; state unchanged, playful nudge signalled.",
      "action": { "type": "submitBluff", "player": 1, "text": "   " },
      "expected": { "rejected": true }
    },
    {
      "id": "E2-decoy-gating",
